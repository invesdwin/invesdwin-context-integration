<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="jppfServer"
		class="de.invesdwin.context.integration.grid.jppf.server.ConfiguredJPPFServer"
		init-method="start" destroy-method="stop">
	</bean>

	<bean id="jppfNode"
		class="de.invesdwin.context.integration.grid.jppf.node.ConfiguredJPPFNode">
		<!-- startup/shutdown is handled manually in server -->
	</bean>

	<bean id="jppfServicePublication"
		class="de.invesdwin.context.integration.grid.jppf.server.internal.JPPFServicePublication">
		<property name="serviceName"
			value="#{T(de.invesdwin.context.integration.grid.jppf.JPPFClientProperties).SERVICE_NAME}" />
	</bean>

</beans>